rules_version = '2';

// Security rules for the whole Roadmaps platform: the hub (this branch) and every
// roadmap site (one branch each). All sites share this one Firebase project, so these
// rules are deployed from the Master branch only.
//
// Roles
// - Admin: the email below, signed in with Google. Sees and manages everything,
//   adds teachers and assigns roadmaps to them.
// - Teacher: has a document in /teachers/{their email} listing the roadmap ids they
//   manage. Must sign in with Google (verified email). Manages only those roadmaps.
// - Student: anyone else who signs in. Reads and writes only their own data.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAdmin() { return verified() && myEmail() == "diyohshiloh4@gmail.com"; }
    function teacherPath() { return /databases/$(database)/documents/teachers/$(myEmail()); }
    function isAnyTeacher() { return isAdmin() || (verified() && exists(teacherPath())); }
    function isTeacherOf(rid) {
      return isAdmin() || (verified() && exists(teacherPath()) && rid in get(teacherPath()).data.roadmaps);
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function studentRoadmap(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.currentRoadmap; }

    // List of published roadmaps. Public, so the landing page can show them.
    match /catalog/{rid} {
      allow read: if true;
      allow write: if isTeacherOf(rid);
    }

    // Teachers and the roadmaps they manage. Only the admin changes this.
    match /teachers/{email} {
      allow read: if isAdmin() || (verified() && myEmail() == email);
      allow write: if isAdmin();
    }

    // Each person's profile: current roadmap and which roadmaps they have started.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAnyTeacher();
      allow create: if isSelf(uid);
      // Mentors of the student's roadmap (and the admin) may correct a student's name.
      allow update: if isSelf(uid) || isAdmin() || (isAnyTeacher() && isTeacherOf(resource.data.currentRoadmap));
      allow delete: if isAdmin();
    }

    // Approval. Admin approves anyone; a teacher approves students on their roadmaps.
    match /access/{uid} {
      allow read: if isSelf(uid) || isAnyTeacher();
      allow write: if isAdmin() || (isAnyTeacher() && isTeacherOf(studentRoadmap(uid)));
    }

    // Per-roadmap data.
    match /r/{rid} {
      // Daily hours, start date, holidays.
      match /settings/{docId} {
        allow read: if signedIn();
        allow write: if isTeacherOf(rid);
      }
      // A student's plan on this roadmap and their daily logs.
      match /students/{uid} {
        allow read: if isSelf(uid) || isTeacherOf(rid);
        allow create: if isSelf(uid);
        // The student, or a mentor of this roadmap (to correct the student's name).
        allow update: if isSelf(uid) || isTeacherOf(rid);
        allow delete: if isTeacherOf(rid);
        match /weeks/{weekId} {
          allow read: if isSelf(uid) || isTeacherOf(rid);
          allow write: if isSelf(uid);
        }
      }
      // Tracks: which track a student chose and which extra tracks they asked for or were given.
      // A student sets their own choice once and may ask for extras, but only the admin can approve,
      // decline or change a track. Mentors of the roadmap can read.
      match /tracks/{uid} {
        function ids() { return ['graphics', 'video', 'web', 'biz']; }
        function okShape() {
          return request.resource.data.keys().hasOnly(['chosen', 'requested', 'approved', 'declined', 'updatedAt'])
            && request.resource.data.get('requested', []).hasOnly(ids())
            && request.resource.data.get('approved', []).hasOnly(ids())
            && request.resource.data.get('declined', []).hasOnly(ids())
            && request.resource.data.get('chosen', '') in ([''] + ids());
        }
        allow read: if isSelf(uid) || isTeacherOf(rid);
        allow create: if isAdmin() || (isSelf(uid) && okShape()
          && request.resource.data.get('approved', []).size() == 0
          && request.resource.data.get('declined', []).size() == 0);
        allow update: if isAdmin() || (isSelf(uid) && okShape()
          && request.resource.data.get('approved', []) == resource.data.get('approved', [])
          && request.resource.data.get('declined', []) == resource.data.get('declined', [])
          && (resource.data.get('chosen', '') == '' || request.resource.data.get('chosen', '') == resource.data.get('chosen', '')));
        allow delete: if isAdmin();
      }
      // Assignments, grades and comments: written by the roadmap's teachers only.
      match /assigned/{uid} {
        allow read: if isSelf(uid) || isTeacherOf(rid);
        allow write: if isTeacherOf(rid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
