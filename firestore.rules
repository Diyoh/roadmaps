rules_version = '2';

// Who can read and write what.
// - The teacher (TEACHER_EMAIL below, signed in with Google) can read every student
//   and write assignments, grades, comments, approvals and plan settings.
// - Each student can read and write only their own plan and daily logs, and can read
//   (but never change) their own assignments, grades and the teacher's comments.
// Keep the email here the same as TEACHER_EMAIL in public/firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn()
        && request.auth.token.email == "diyohshiloh4@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Plan settings: daily hours, start date, holidays.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // A student's own plan: commitment, milestones, exams, submissions, summary.
    match /students/{uid} {
      allow read: if isSelf(uid) || isTeacher();
      allow create, update: if isSelf(uid) && request.resource.size() < 200000;
      allow delete: if isTeacher();

      // Daily logs, one document per week.
      match /weeks/{weekId} {
        allow read: if isSelf(uid) || isTeacher();
        allow write: if isSelf(uid);
      }
    }

    // Written only by the teacher: approval, assignments, grades, comments, feedback.
    match /assigned/{uid} {
      allow read: if isSelf(uid) || isTeacher();
      allow write: if isTeacher();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
